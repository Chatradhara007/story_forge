NVIDIA_API_KEY=your_key_here
DATABASE_URL=postgresql://storyforge:storyforge@localhost:5432/storyforge

# ---------------------------------------------------------------------------
# AI models. nvidia/nemotron-3-super-120b-a12b was retired by NVIDIA on 2026-10-03.
# Run  python eval/probe_models.py  to see what is live on YOUR key and which is fastest /
# most accurate on StoryForge's real requests; it prints the lines to paste here.
# ---------------------------------------------------------------------------
# Reading facts from chapters (~10 calls per chapter): pick for SPEED.
# CHAT_MODEL_READING=nvidia/nemotron-3.5-lightning-30b-a3b
# Linking names, checking for mistakes, double-check, chapter timing: pick for ACCURACY.
# CHAT_MODEL_JUDGING=nvidia/nemotron-3-ultra-550b-a55b
# Tried in order if NVIDIA says a model is gone (404/410). StoryForge switches automatically
# and /health shows which models are in use and which were found retired.
# CHAT_MODEL_FALLBACKS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-lightning-30b-a3b,openai/gpt-oss-120b,openai/gpt-oss-20b
# Older single setting: sets both roles at once.
# CHAT_MODEL=
# Embeddings. No automatic fallback: a different model's vectors can't be compared with the
# ones already stored (and the database column is 2048 numbers wide).
# EMBED_MODEL=nvidia/nemotron-3-embed-1b
# Give up on a single AI request after this many seconds (default 180).
# AI_REQUEST_TIMEOUT=180

# Optional: when deployed, only allow your own website to call the API (comma-separated).
# ALLOWED_ORIGINS=https://storyforge-yourname.onrender.com

# Optional: set to false to stop the app creating database tables on start-up.
# AUTO_CREATE_SCHEMA=true

# Optional: how much the AI "thinks" before answering: off, low (short think), or on (slow).
# CHAT_THINKING is for reading facts from chapters (default off: this is the slow step).
# CHAT_THINKING_JUDGING is for linking names and checking for mistakes (default low).
# CHAT_THINKING=off
# CHAT_THINKING_JUDGING=low

# Optional: how many requests may be in flight to NVIDIA at once, in total (default 4).
# Lower it if NVIDIA keeps refusing requests with "429 Too Many Requests".
# MAX_PARALLEL_AI_CALLS=4
# Optional: cap on requests per minute (default 30; 0 = no cap). Keeps you under NVIDIA's
# usage limit. Raise it if your plan allows more.
# MAX_REQUESTS_PER_MINUTE=30
# Optional: how long to keep waiting when NVIDIA says "Too Many Requests" (default 300 s).
# AI_RATE_LIMIT_PATIENCE=300
# Optional: how many times to try a failing request before giving up (default 6).
# AI_RETRY_ATTEMPTS=6

# Optional: randomness of the AI's answers, 0 (same answer every time) to 1 (varied).
# Low values make results repeatable between runs.
# CHAT_TEMPERATURE=0.2

# Optional: chapters are read in passages of about this many characters (default 700).
# Smaller = more detail recorded but more AI calls; larger = fewer calls, less detail.
# READ_PASSAGE_CHARS=700

# ---------------------------------------------------------------------------
# Accounts (switch ON for any deployment other people can reach)
# ---------------------------------------------------------------------------
# AUTH_REQUIRED=false            # true = sign-in required, each user sees only their own books
# SECRET_KEY=                    # long random text; signs sessions. Generate one with:
#                                #   python -c "import secrets; print(secrets.token_hex(32))"
# DAILY_CHAPTER_LIMIT=40         # chapter checks per user per day (0 = unlimited)
# ALLOW_REGISTRATION=true        # false = no new accounts
# INVITE_CODE=                   # if set, needed to create an account
# ALLOWED_ORIGINS=               # other websites allowed to call the API (none when sign-in is on)
# HOURLY_QUESTION_LIMIT=60       # Ask / search questions per user per hour (0 = unlimited)
# SESSION_DAYS=30                # how long a sign-in lasts
# BEHIND_PROXY=false             # true on Render/Fly/behind a load balancer (real visitor address)
# APP_URL=                       # the website's address, used in password-reset links
# Password-reset emails. Without SMTP_HOST the reset link is printed in the server log instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=StoryForge <no-reply@example.com>

# ---------------------------------------------------------------------------
# Scale and background work
# ---------------------------------------------------------------------------
# MAX_EVIDENCE_FACTS=60          # most earlier facts the checker sees per character (keeps prompts small)
# MAX_PARALLEL_JOBS=2            # books processed at the same time (one job per book at a time)
# DB_POOL_MAX=10                 # database connections kept open
