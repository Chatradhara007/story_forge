NVIDIA_API_KEY=your_key_here
DATABASE_URL=postgresql://storyforge:storyforge@localhost:5432/storyforge

# ---------------------------------------------------------------------------
# AI models (see docs/FINAL-CONFIGURATION.md for why these were chosen).
# nvidia/nemotron-3-super-120b-a12b was retired by NVIDIA on 2026-10-03.
# Each line is a LIST, best first: if NVIDIA retires a model (404/410) or it keeps failing,
# the next one takes over automatically, and /health shows which is in use.
#   python check_models.py               quick check of what your key can use (backend/)
#   python ../eval/probe_models.py       compare candidates on StoryForge's real requests
#   python ../eval/run_eval.py --judges "a,b"   compare judges on identical reading
# ---------------------------------------------------------------------------
# READER: reads every passage, chapter timing, the Ask box. Most requests: pick for SPEED.
CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# JUDGE: links names, checks for mistakes, safety net, double-check. Pick for ACCURACY.
# If every judge is gone, the readers judge.
JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-lightning-30b-a3b
# Ultra crashes (500 errors) when asked to think, so the judge doesn't think.
CHAT_THINKING_JUDGING=off
# Older names (12 Oct build) still work and go first in their list:
# CHAT_MODEL_READING= / CHAT_MODEL_JUDGING= / CHAT_MODEL_FALLBACKS=
# Embeddings. No automatic fallback: a different model's vectors can't be compared with the
# stored ones. After changing it, stop the server and run  python reembed.py  once.
# EMBED_MODEL=nvidia/nemotron-3-embed-1b
# Give up on a single AI request after this many seconds (default 180).
# AI_REQUEST_TIMEOUT=180

# Optional: when deployed, only allow your own website to call the API (comma-separated).
# ALLOWED_ORIGINS=https://storyforge-yourname.onrender.com

# Optional: set to false to stop the app creating database tables on start-up.
# AUTO_CREATE_SCHEMA=true

# Optional: how much the AI "thinks" before answering: off, low (short think), or on (slow).
# CHAT_THINKING is for the reader (default off). CHAT_THINKING_JUDGING is set above.
# A model that crashes twice while thinking is switched to "off" automatically.
# CHAT_THINKING=off
# CHAT_THINKING_BUDGET=2048      # extra answer room (tokens) when a model thinks

# Optional: how many requests may be in flight to NVIDIA at once, in total (default 4).
# Lower it if NVIDIA keeps refusing requests with "429 Too Many Requests".
# MAX_PARALLEL_AI_CALLS=4      # 6 makes judging faster if NVIDIA doesn't answer 429
# Optional: cap on requests per minute (default 30; 0 = no cap). Keeps you under NVIDIA's
# usage limit. Raise it if your plan allows more.
# MAX_REQUESTS_PER_MINUTE=30
# Optional: how long to keep waiting when NVIDIA says "Too Many Requests" (default 300 s).
# AI_RATE_LIMIT_PATIENCE=300
# Optional: how many times to try a failing request before giving up (default 6).
# AI_RETRY_ATTEMPTS=6

# Optional: randomness of the AI's answers, 0 (same answer every time) to 1 (varied).
# Default 0 for both: the same chapter gives the same result every run.
# CHAT_TEMPERATURE=0.0
# JUDGE_TEMPERATURE=0.0
# Optional: tries before a failing model hands over to the next one, and how long it's set aside.
# AI_FAILOVER_AFTER=4
# AI_SET_ASIDE_SECONDS=120

# Optional: chapters are read in passages of about this many characters (default 700).
# Smaller = more detail recorded but more AI calls; larger = fewer calls, less detail.
# READ_PASSAGE_CHARS=700

# ---------------------------------------------------------------------------
# Accounts (switch ON for any deployment other people can reach)
# ---------------------------------------------------------------------------
# AUTH_REQUIRED=false            # true = sign-in required, each user sees only their own books
# SECRET_KEY=                    # long random text; signs sessions. Generate one with:
#                                #   python -c "import secrets; print(secrets.token_hex(32))"
# DAILY_CHAPTER_LIMIT=40         # chapter checks per user per day (0 = unlimited)
# ALLOW_REGISTRATION=true        # false = no new accounts
# GOOGLE_CLIENT_ID=              # shows "Continue with Google" (see docs/GOOGLE-SIGN-IN.md)
# INVITE_CODE=                   # if set, needed to create an account
# ALLOWED_ORIGINS=               # other websites allowed to call the API (none when sign-in is on)
# HOURLY_QUESTION_LIMIT=60       # Ask / search questions per user per hour (0 = unlimited)
# SESSION_DAYS=30                # how long a sign-in lasts
# BEHIND_PROXY=false             # true on Render/Fly/behind a load balancer (real visitor address)
# APP_URL=                       # the website's address, used in password-reset links
# Password-reset emails. Without SMTP_HOST the reset link is printed in the server log instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=StoryForge <no-reply@example.com>

# ---------------------------------------------------------------------------
# Scale and background work
# ---------------------------------------------------------------------------
# MAX_EVIDENCE_FACTS=60          # most earlier facts the checker sees per character (keeps prompts small)
# MAX_PARALLEL_JOBS=2            # books processed at the same time (one job per book at a time)
# DB_POOL_MAX=10                 # database connections kept open

# DECIDED SETUP (19 Oct 2026, docs/FREE-SETUP.md): one free NVIDIA model reads and judges, the
# checks run in code, the AI checker and safety net are off, names are linked by rules.
CHECKER=off
SAFETY_NET=off
# Name linking: "ai" asks the judge model about names the name rules can't link;
# "rules" never asks (much faster on a slow or overloaded API).
NAME_LINKING=rules
# After an AI outage while linking names, skip the AI for this many seconds (default 900).
NAME_LINKING_PAUSE=900

# Reading cache: a folder where each chapter's reading and fact vectors are saved and reused
# when the SAME text is checked again (spacing ignored). For demos: check the chapters once
# beforehand, and on the day they are checked in seconds even if NVIDIA is slow or down.
# READING_CACHE=reading-cache

# A model on your own GPU (see docs/LOCAL-MODEL.md), e.g. Ollama:
# AI_BASE_URL=http://localhost:11434/v1
# CHAT_MODEL=qwen2.5:14b-instruct
# JUDGE_MODEL=qwen2.5:14b-instruct
# Embeddings from a different server than the chat models (default: NVIDIA while EMBED_MODEL is nvidia/...)
# EMBED_BASE_URL=

# Other free services can be chained with labels (docs/FREE-SETUP.md), but on 19 Oct 2026 none
# beat NVIDIA for reading whole stories (Groq's free plan allows only 8,000 tokens a minute).
# Model names change: list what your key offers before using one.
# CHAT_MODEL=mistral:<model>,nvidia:nvidia/nemotron-3.5-lightning-30b-a3b
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# GEMINI_API_KEY=          (free tier may train on prompts: test stories only)
# OPENROUTER_API_KEY=
